# Magnitude MCP Server Configuration

# Server Settings
MAGNITUDE_MCP_PORT=9123
USE_SECURE_CDP=true

# API Keys (required)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Security Keys
MCP_API_KEY=your-mcp-api-key-here
BROWSER_API_KEY=your-browser-api-key-here

# Chrome DevTools Protocol (for development only)
# CDP_URL=http://localhost:9222

# AWS Configuration (for production)
# AWS_REGION=us-west-2
# AWS_ACCOUNT_ID=your-account-id